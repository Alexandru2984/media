# Brevo SMTP Configuration
# Get these from: https://app.brevo.com/settings/keys/smtp
SMTP_SERVER=smtp-relay.brevo.com
SMTP_USERNAME=your-brevo-email@example.com
SMTP_PASSWORD=your-brevo-smtp-key-here
FROM_EMAIL=noreply@socialapp.com

# Application URLs
APP_URL_LOCAL=http://localhost:3005
APP_URL_PRODUCTION=https://your-domain.com

# Environment: development or production
ENVIRONMENT=development
