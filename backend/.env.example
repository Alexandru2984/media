# Database
DATABASE_URL=mysql://media_user:change-me@127.0.0.1:3306/media

# Transactional email
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
FROM_EMAIL=noreply@example.com

# Application URLs and runtime
APP_URL_LOCAL=http://127.0.0.1:5173
APP_URL_PRODUCTION=https://media.example.com
ENVIRONMENT=development
JWT_SECRET=replace-with-at-least-32-cryptographically-random-bytes
SERVER_HOST=127.0.0.1
SERVER_PORT=8083
CORS_ORIGIN=http://127.0.0.1:5173
