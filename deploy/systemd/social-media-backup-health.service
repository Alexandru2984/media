[Unit]
Description=Validate Media off-site backup and restore freshness
Documentation=file:/var/www/media.micutu.com/deploy/scripts/README.md
After=social-media-backup.service social-media-restore-drill.service
OnFailure=swift-vapor-alert@%n.service
ConditionPathExists=/usr/local/libexec/social-media-backup-health

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/
ExecStart=/usr/local/libexec/social-media-backup-health
TimeoutStartSec=1m

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/social-media-backup
InaccessiblePaths=/etc/social-media
InaccessiblePaths=/var/www/media.micutu.com
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=128
TasksMax=16
MemoryMax=64M
