[Unit]
Description=Media encrypted off-site database and upload backup
Documentation=file:/var/www/media.micutu.com/deploy/scripts/README.md
Wants=network-online.target mysql.service
After=network-online.target mysql.service
ConditionPathIsReadWrite=/var/backups/social-media-offsite
ConditionPathIsReadWrite=/etc/social-media/rclone-backup.conf
ConditionPathExists=/usr/local/libexec/social-media-backup

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=www-data
UMask=0077
WorkingDirectory=/
ExecStart=/usr/local/libexec/social-media-backup
StateDirectory=social-media-backup
StateDirectoryMode=0700
RuntimeDirectory=social-media-backup
RuntimeDirectoryMode=0700
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/media.micutu.com/backend/uploads
InaccessiblePaths=/var/www/media.micutu.com/backend/.env
ReadWritePaths=/var/backups/social-media-offsite
ReadWritePaths=/etc/social-media
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=4096
TasksMax=128
MemoryMax=1G

[Install]
WantedBy=multi-user.target
