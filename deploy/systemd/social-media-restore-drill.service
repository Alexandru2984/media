[Unit]
Description=Media isolated off-site backup restore verification
Documentation=file:/var/www/media.micutu.com/deploy/scripts/README.md
Wants=network-online.target mysql.service
After=network-online.target mysql.service
ConditionPathIsReadWrite=/var/backups/social-media-offsite
ConditionPathIsReadWrite=/etc/social-media/rclone-backup.conf

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/var/www/media.micutu.com
ExecStart=/var/www/media.micutu.com/deploy/scripts/drill-offsite-restore.sh
StateDirectory=social-media-backup
StateDirectoryMode=0700
RuntimeDirectory=social-media-backup
RuntimeDirectoryMode=0700
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/media.micutu.com
ReadWritePaths=/var/backups/social-media-offsite
ReadWritePaths=/etc/social-media
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=4096
TasksMax=128
MemoryMax=1G

[Install]
WantedBy=multi-user.target
