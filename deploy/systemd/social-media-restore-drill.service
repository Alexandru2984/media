[Unit]
Description=Media isolated off-site backup restore verification
Documentation=file:/var/www/media.micutu.com/deploy/scripts/README.md
Wants=network-online.target mysql.service
After=network-online.target mysql.service
OnFailure=swift-vapor-alert@%n.service
ConditionPathIsReadWrite=/var/backups/social-media-offsite
ConditionPathIsReadWrite=/etc/social-media/rclone-backup.conf
ConditionPathExists=/usr/local/libexec/social-media-restore-drill

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/
ExecStart=/usr/local/libexec/social-media-restore-drill
StateDirectory=social-media-backup
StateDirectoryMode=0700
RuntimeDirectory=social-media-backup
RuntimeDirectoryMode=0700
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/var/www/media.micutu.com/backend/.env
ReadWritePaths=/var/backups/social-media-offsite
ReadWritePaths=/etc/social-media
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
# systemd 259 makes RestrictSUIDSGID block GNU tar's safe openat2 traversal.
# The drill rejects special archive modes and extracts with mode preservation off.
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=4096
TasksMax=128
MemoryMax=1G

[Install]
WantedBy=multi-user.target
