[Unit]
Description=Validate Media production service and HTTP boundaries
Documentation=file:/var/www/media.micutu.com/deploy/scripts/README.md
Wants=network-online.target
After=network-online.target
OnFailure=swift-vapor-alert@%n.service
ConditionPathExists=/usr/local/libexec/social-media-service-health

[Service]
Type=oneshot
DynamicUser=true
UMask=0077
WorkingDirectory=/
ExecStart=/usr/local/libexec/social-media-service-health
TimeoutStartSec=90s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/etc/social-media
InaccessiblePaths=/var/www/media.micutu.com/backend/.env
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=128
TasksMax=32
MemoryMax=96M
