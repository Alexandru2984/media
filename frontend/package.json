  "description": "Social Media Frontend with Solid.js",
  "dependencies": {
    "@solidjs/router": "^0.15.4",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.18",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14"
  }
}
